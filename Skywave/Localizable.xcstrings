        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The frequency %@ kHz could not be set through rigctld. %@"
          }
        }
      }
    },
    "Die Gegenstelle unterstützt das B2F-Protokoll nicht." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The remote station does not support the B2F protocol."
