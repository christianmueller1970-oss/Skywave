    "Das Funkgerät meldet keine ALC — bitte von Hand einstellen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The rig does not report ALC — please set the level by hand."
          }
        }
      }
    },
    "Das Funkgerät%@ antwortet nicht — eingeschaltet? Modell, Port und Baudrate prüfen. (%@)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
