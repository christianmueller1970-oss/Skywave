          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The rig%@ does not respond — is it switched on? Check model, port and baud rate. (%@)"
          }
        }
      }
    },
    "Das integrierte ardopcf fehlt im App-Bundle — bitte Skywave neu installieren." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The integrated ardopcf is missing from the app bundle — please reinstall Skywave."
          }
